# Copie para .env (que NÃO é versionado) e ajuste. Todas as variáveis são opcionais:
# sem .env o pipeline usa os valores abaixo.

# Período de extração (data de referência do ONS), AAAA-MM-DD
DATA_INICIO=2026-08-01
DATA_FIM=2026-10-31

# Áreas de carga separadas por vírgula; vazio = todas as de config/areas_carga.csv
AREAS=

# Resiliência HTTP
HTTP_TIMEOUT_CONNECT_S=10
HTTP_TIMEOUT_READ_S=60
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_FACTOR=1.0

# Controle de taxa: intervalo mínimo (s) entre chamadas a cada API
ONS_MIN_INTERVAL_S=1.0
OPEN_METEO_MIN_INTERVAL_S=0.5
NAGER_MIN_INTERVAL_S=1.0

# Credencial: as três APIs são abertas e NÃO exigem chave. Preencha só se usar o
# plano comercial do Open-Meteo. Nunca coloque o valor real neste arquivo.
OPEN_METEO_API_KEY=

# Pastas (relativas à raiz do projeto)
RAW_DIR=data/raw
OUTPUT_DIR=output
