{
  "version": "2.0.0",
  "options": { "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
  "tasks": [
    {
      "label": "1. Criar ambiente (.venv)",
      "type": "shell",
      "command": "python -m venv .venv",
      "problemMatcher": []
    },
    {
      "label": "2. Instalar dependências",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "problemMatcher": []
    },
    {
      "label": "3. Rodar testes",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-q"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "4. Pipeline: teste rápido (PA, 1 dia)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pipeline.main", "--inicio", "2026-10-01", "--fim", "2026-10-01", "--areas", "PA"],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/src",
          "RAW_DIR": "data/teste-rapido/raw",
          "OUTPUT_DIR": "data/teste-rapido/output"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "5. Pipeline: execução completa (.env)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pipeline.main"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "6. Pipeline: sem extração (reusa data/raw)",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pipeline.main", "--skip-extract"],
      "problemMatcher": []
    }
  ]
}
